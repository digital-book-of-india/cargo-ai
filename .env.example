# See apps/backend/.env.example, apps/*/.env.example, apps/ai-worker/.env.example



# Platform & Server
PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/dbi-intelligence
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Dev 2 Administration Controls
CAMERA_STALE_SECONDS=120
WORKER_STALE_SECONDS=60
ADMIN_RATE_LIMIT_PER_MIN=100
SWAGGER_ENABLED=true
ALLOW_MOCK_AUTH=false

# Super Admin Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_USE_MOCKS=false