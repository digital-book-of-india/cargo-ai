{
  "name": "dbi-intelligence",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev:owner": "npm run dev -w @dbi/owner",
    "dev:superadmin": "npm run dev -w @dbi/superadmin",
    "dev:backend": "npm run dev -w @dbi/backend",
    "seed": "npm run seed -w @dbi/backend",
    "build:owner": "npm run build -w @dbi/owner",
    "build:superadmin": "npm run build -w @dbi/superadmin",
    "test:owner": "npm run test -w @dbi/owner",
    "test:superadmin": "npm run test -w @dbi/superadmin",
    "test": "npm run test:owner && npm run test:superadmin && npm run test -w @dbi/backend",
    "bench:load": "tsx scripts/load-test.ts",
    "eval:accuracy": "tsx scripts/evaluate-accuracy.ts",
    "check:secrets": "node scripts/check-secrets.js",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
