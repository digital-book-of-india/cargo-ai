# Base URL of the backend API (Dev 3)
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# true = use local mock responses (all marked DEMO) until the backend is ready
NEXT_PUBLIC_USE_MOCKS=false
# optional refresh intervals in ms (defaults shown)
# NEXT_PUBLIC_CAMERA_REFRESH_MS=15000
# NEXT_PUBLIC_SECURITY_REFRESH_MS=30000
# NEXT_PUBLIC_ALERTS_REFRESH_MS=30000
# NEXT_PUBLIC_NOTIFICATIONS_REFRESH_MS=30000
