# Baked in by the OS environment before `npm start` / electron-builder packaging.
# The packaged exe reads this from the environment at build time (see src/lib/config.js);
# there is no .env loader at runtime, so set it before running `npm run dist` / `npm run publish`.
THEAFT_BACKEND_URL=https://api.theaft.digitalbookofindia.com

# Needed only when publishing (`npm run publish`): must equal CONNECTOR_PUBLISH_KEY on the backend.
# CONNECTOR_PUBLISH_KEY=
