{
  "name": "@dbi/connector",
  "version": "0.1.0",
  "private": true,
  "author": "StaffPie",
  "description": "StaffPie Connector - on-site Windows agent that pairs a site's LAN with the backend, syncs cameras, and will drive attendance/live-view workers.",
  "main": "src/main.js",
  "scripts": {
    "prestart": "node scripts/write-runtime-config.js",
    "start": "electron .",
    "predist": "node scripts/write-runtime-config.js",
    "dist": "electron-builder --win --publish never",
    "prepublish": "node scripts/write-runtime-config.js",
    "publish": "electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-log": "^5.2.3",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "app-builder-bin": "^4.2.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.staffpie.connector",
    "productName": "StaffPie Connector",
    "electronVersion": "33.4.11",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "publish": {
        "provider": "github",
        "owner": "digital-book-of-india",
        "repo": "theaft-ai",
        "releaseType": "release"
      }
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
