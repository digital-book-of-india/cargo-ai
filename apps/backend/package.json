{
  "name": "@dbi/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "node scripts/build.js",
    "start": "node dist/server.js",
    "seed": "tsx src/seeds/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.js unit",
    "test:int": "node scripts/run-tests.js int",
    "migrate": "tsx src/migrations/cli.ts up",
    "migrate:down": "tsx src/migrations/cli.ts down",
    "migrate:status": "tsx src/migrations/cli.ts status",
    "job:retention": "tsx src/jobs/retention.ts",
    "job:notifications": "tsx src/jobs/notifications.ts",
    "backup": "tsx src/ops/backup.ts",
    "restore": "tsx src/ops/restore.ts"
  },
  "dependencies": {
    "@dbi/api-types": "*",
    "@dbi/validation": "*",
    "bcryptjs": "^2.4.3",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.21.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "8.7.1",
    "multer": "^2.5.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.3.0",
    "@types/node": "20.14.10",
    "esbuild": "^0.23.1",
    "yaml": "^2.5.0",
    "tsx": "4.19.1",
    "typescript": "5.5.4"
  }
}
