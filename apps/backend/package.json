{
  "name": "@dbi/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "node scripts/build.js",
    "start": "node dist/server.js",
    "seed": "tsx src/seeds/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.js unit",
    "test:int": "node scripts/run-tests.js int",
    "migrate": "tsx src/migrations/cli.ts up",
    "migrate:down": "tsx src/migrations/cli.ts down",
    "migrate:status": "tsx src/migrations/cli.ts status",
    "job:retention": "tsx src/jobs/retention.ts",
    "job:notifications": "tsx src/jobs/notifications.ts",
    "backup": "tsx src/ops/backup.ts",
    "restore": "tsx src/ops/restore.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1157.0",
    "@dbi/api-types": "*",
    "@dbi/validation": "*",
    "bcryptjs": "2.4.3",
    "compression": "1.8.2",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.22.3",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "jsonwebtoken": "9.0.3",
    "mongoose": "8.24.7",
    "multer": "2.5.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/compression": "1.8.1",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/jsonwebtoken": "9.0.10",
    "@types/multer": "2.3.0",
    "@types/node": "20.14.10",
    "esbuild": "0.23.1",
    "tsx": "4.23.15",
    "typescript": "5.5.4",
    "yaml": "2.9.1"
  }
}
