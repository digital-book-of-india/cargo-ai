CAMERA_STALE_SECONDS=120
WORKER_STALE_SECONDS=60
ADMIN_RATE_LIMIT_PER_MIN=100

# Request body limit (bigger bodies get 413 PAYLOAD_TOO_LARGE)
BODY_LIMIT=1mb

# Evidence (snapshots and clips): private storage, signed expiring links, retention
EVIDENCE_STORAGE_DRIVER=local
EVIDENCE_STORAGE_DIR=uploads
EVIDENCE_SIGNED_URL_TTL_SECONDS=300
EVIDENCE_MAX_UPLOAD_BYTES=8388608
CARGO_EVENT_RETENTION_DAYS=90

# Integration tests only: a separate database whose name MUST end with _test (it is dropped after the run).
# Leave unset to derive "<your database>_test" from MONGODB_URI.
# MONGODB_URI_TEST=

# Rotate the AI token without downtime: put the OLD token here until the worker has the new one
# AI_SERVICE_TOKEN_PREVIOUS=

# Logging (json lines in production, readable lines otherwise) and proxy trust
# LOG_LEVEL=info
# LOG_FORMAT=pretty
# TRUST_PROXY=0
# DNS_SERVERS=8.8.8.8,8.8.4.4
