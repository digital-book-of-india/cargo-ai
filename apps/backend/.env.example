# Copy to .env and fill in. Never commit real values.
PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/cargo_ai?retryWrites=true&w=majority
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=
CAMERA_SECRET_ENCRYPTION_KEY=
# Shared with apps/ai-worker (AI_SERVICE_TOKEN there)
AI_SERVICE_TOKEN=

CAMERA_STALE_SECONDS=120
WORKER_STALE_SECONDS=60
ADMIN_RATE_LIMIT_PER_MIN=100
SWAGGER_ENABLED=true
ALLOW_MOCK_AUTH=false
