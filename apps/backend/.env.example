NODE_ENV=development
MONGODB_URI=mongodb+srv://digitalbookofindia_db_user:SNLP4B6RbKz37Jht@cluster0.gh4c2ri.mongodb.net/cargo_ai?retryWrites=true&w=majority&appName=Cluster0
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
