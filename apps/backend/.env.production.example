# Production environment template for @dbi/backend.
# Copy to the hosting platform's env config (Render/Railway/EC2/etc.) — never commit real
# values. Generate every secret below fresh; never reuse the dev defaults from .env.example.

PORT=4000
NODE_ENV=production

# A SEPARATE production database — do not point this at the same cluster/DB used for dev
# testing. Create a dedicated MongoDB Atlas database (or cluster) for production data.
MONGODB_URI=mongodb+srv://<prod-user>:<prod-password>@<prod-cluster>/dbi_intelligence_prod?retryWrites=true&w=majority

# Real deployed frontend origins only — no localhost.
CORS_ORIGINS=https://<owner-app-domain>,https://<admin-app-domain>

# Generate fresh random secrets, e.g.: openssl rand -hex 32
JWT_ACCESS_SECRET=<generate-a-long-random-secret>
CAMERA_SECRET_ENCRYPTION_KEY=<generate-a-separate-32+char-secret>
AI_SERVICE_TOKEN=<generate-a-separate-random-secret-shared-with-the-ai-worker-only>

# Where evidence snapshots/clips are written. On most PaaS platforms (Render, Railway,
# Heroku-style) the local filesystem is EPHEMERAL and is wiped on every redeploy/restart —
# point this at a mounted persistent volume, or migrate the evidence routes to real object
# storage (S3/GCS) before relying on this in production.
EVIDENCE_STORAGE_DIR=/data/evidence

# Super Admin panel controls — safe to keep these defaults
CAMERA_STALE_SECONDS=120
WORKER_STALE_SECONDS=60
ADMIN_RATE_LIMIT_PER_MIN=100

# MUST be false (or omitted entirely) in production — this is the dev-only admin auth
# bypass. The code also hard-gates it behind NODE_ENV!=="production" as a second layer,
# but set it explicitly anyway.
ALLOW_MOCK_AUTH=false

# Leave these empty / do not set in production. They only feed `npm run seed`, and that
# script must never be run against a production database — it deletes/recreates the
# admin@dbi.com and owner@dbi.com accounts on every run.
# CAMERA_RTSP_HOST=
# CAMERA_RTSP_PORT=
# CAMERA_RTSP_USERNAME=
# CAMERA_RTSP_PASSWORD=
# CAMERA_RTSP_PATH=
