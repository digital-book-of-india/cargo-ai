# Production environment template for @dbi/backend.
# Copy to the hosting platform's env config (Render/Railway/EC2/Docker/etc.). Never commit real
# values. Generate every secret below fresh; never reuse the dev defaults from .env.example.
# The full explanation of every variable is in docs/production-env.md.

PORT=4000
NODE_ENV=production

# A SEPARATE production database. Do not point this at the cluster/DB used for development.
MONGODB_URI=mongodb+srv://<prod-user>:<prod-password>@<prod-cluster>/cargo_ai_prod?retryWrites=true&w=majority

# Real deployed frontend origins only, no localhost.
CORS_ORIGINS=https://<owner-app-domain>,https://<admin-app-domain>

# Generate fresh random secrets, e.g.: openssl rand -hex 32
# The server refuses to start in production if any of these three is missing.
JWT_ACCESS_SECRET=<generate-a-long-random-secret>
CAMERA_SECRET_ENCRYPTION_KEY=<generate-a-separate-32+char-secret>
AI_SERVICE_TOKEN=<generate-a-separate-random-secret-shared-with-the-ai-worker-only>

# Number of reverse proxies in front of the API (load balancer, nginx...). 0 = none.
# With 0 the rate limits see the proxy's address for everyone; with a wrong number callers can
# fake their address. Set it to the real number of hops.
TRUST_PROXY=1

# Where evidence snapshots/clips are written. On most PaaS platforms the local filesystem is
# EPHEMERAL: mount a persistent volume here (and back it up, see docs/runbook.md).
EVIDENCE_STORAGE_DIR=/data/evidence
EVIDENCE_STORAGE_DRIVER=local
# Object storage instead of a local volume (needed for several servers or containers without a persistent disk):
# EVIDENCE_STORAGE_DRIVER=s3
# EVIDENCE_S3_BUCKET=your-private-bucket
# EVIDENCE_S3_REGION=ap-south-1
# EVIDENCE_S3_PREFIX=evidence
# EVIDENCE_S3_ENDPOINT=            # only for Google Cloud Storage (https://storage.googleapis.com) or MinIO
# EVIDENCE_S3_FORCE_PATH_STYLE=false
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY: set in the platform's secret store (or use the platform role)
EVIDENCE_SIGNED_URL_TTL_SECONDS=300
EVIDENCE_MAX_UPLOAD_BYTES=8388608
CARGO_EVENT_RETENTION_DAYS=90
# ACCESS_TOKEN_TTL=12h
# CAMERA_ALLOW_PRIVATE_HOSTS=true   # only when the API runs inside the customer's network
CARGO_NOTIFICATION_RETENTION_DAYS=90
CARGO_AUDIT_RETENTION_DAYS=365

# Super admin panel and camera health
CAMERA_STALE_SECONDS=120
WORKER_STALE_SECONDS=60
ADMIN_RATE_LIMIT_PER_MIN=100

# Request body limit
BODY_LIMIT=1mb

# Logging: json lines by default in production. LOG_LEVEL is debug, info, warn or error.
LOG_LEVEL=info
# LOG_FORMAT=json

# Only if the network cannot resolve mongodb+srv:// addresses with its own resolvers.
# DNS_SERVERS=8.8.8.8,8.8.4.4

# Do not set anything for `npm run seed` in production: that script creates demo accounts and
# must never be run against a production database.

# Indexes are NOT built on start in production. Run once per release: npm run migrate

# Redis (cache and shared limits). Use REDIS_URL (rediss:// for TLS), or the separate values below it.
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false
