BACKEND_BASE_URL=http://localhost:4000
AI_SERVICE_TOKEN=change-me
WORKER_ID=worker-1

# How often (seconds) to send the health heartbeat
HEARTBEAT_INTERVAL=30

# How often (seconds) to run person-detection on each camera's latest frame
DETECTION_INTERVAL_SECONDS=1

# How often (seconds) to re-scan the backend for newly added cameras
CAMERA_DISCOVERY_INTERVAL=60

# Seconds a person must stay in the zone before PERSON_IN_ZONE escalates to
# POSSIBLE_SHUTTER_INTERACTION
SHUTTER_INTERACTION_SECONDS=3

# Minimum seconds between repeat events of the same severity for the same camera
EVENT_COOLDOWN_SECONDS=60
